.head-card {
  padding: 28rpx;
}

.tag-row {
  margin-bottom: 12rpx;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.poi-card {
  padding: 24rpx;
}

.poi-row {
  display: flex;
  align-items: center;
}

.seq {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #16a085;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.poi-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  background: #eee;
  flex-shrink: 0;
}

.poi-info {
  flex: 1;
  min-width: 0;
}

.poi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.poi-type {
  font-size: 22rpx;
  font-weight: 400;
  color: #16a085;
  background: #eef7f5;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.reason {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}
