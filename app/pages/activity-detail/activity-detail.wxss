.detail-card {
  overflow: hidden;
  padding: 0;
}

.cover {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #eee;
}

.body {
  padding: 24rpx;
}

.tag-row {
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}

.desc {
  margin-top: 12rpx;
  color: #555;
  line-height: 1.7;
}

.action {
  padding: 24rpx;
}