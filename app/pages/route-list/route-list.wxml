<view class="container">
  <view wx:if="{{routes.length === 0}}" class="empty">暂无主题路线</view>

  <view
    wx:for="{{routes}}"
    wx:key="id"
    class="card route-card"
    bindtap="openDetail"
    data-id="{{item.id}}"
  >
    <view class="tag-row">
      <text class="tag">{{item.themeText}}</text>
      <text class="tag">{{item.streetAreaName}}</text>
    </view>
    <view class="card-title">{{item.name}}</view>
    <view class="card-sub">{{item.durationText}} · {{item.poiCount}}个打卡点</view>
  </view>
</view>
