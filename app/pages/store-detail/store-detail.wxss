.detail-card {
  overflow: hidden;
  padding: 0;
}

.cover {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #eee;
}

.detail-card .card-title,
.tag-row,
.detail-card .card-sub {
  padding: 0 24rpx;
}

.tag-row {
  margin: 16rpx 0;
}

.detail-card .card-sub {
  padding-bottom: 24rpx;
}

.row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}