<view class="container">
  <view wx:if="{{coupons.length === 0}}" class="empty">暂无优惠券，去优惠券列表领取吧</view>

  <view
    wx:for="{{coupons}}"
    wx:key="id"
    class="card coupon-card {{item.status !== 'AVAILABLE' ? 'coupon-dim' : ''}}"
    bindtap="openDetail"
    data-id="{{item.id}}"
  >
    <view class="coupon-left">
      <view class="discount">{{item.discountText}}</view>
    </view>
    <view class="coupon-body">
      <view class="card-title">{{item.name}}</view>
      <view class="card-sub">{{item.storeName}}</view>
      <view class="card-sub">有效期至 {{item.validTo}}</view>
    </view>
    <view class="coupon-status {{item.status === 'REDEEMED' ? 'status-used' : ''}}">{{item.statusText}}</view>
  </view>
</view>
