.row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.label {
  width: 140rpx;
  color: #888;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}

.task-hero {
  text-align: center;
  padding: 20rpx 0;
}

.reward-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #fdf1e7;
  color: #e67e22;
  font-size: 26rpx;
}

.status-tag {
  margin-top: 16rpx;
}

.code-text {
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #222;
  margin: 24rpx 0;
}

.qr-canvas {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  display: block;
}

.reward-result {
  text-align: center;
  margin: 24rpx 0;
}

.reward-points {
  font-size: 64rpx;
  font-weight: 700;
  color: #e67e22;
}

.reward-unit {
  font-size: 28rpx;
  color: #e67e22;
  margin-left: 8rpx;
}
