.cover {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #eee;
}

.switch {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #666;
  font-size: 28rpx;
}

.switch-item.active {
  background: #16a085;
  color: #fff;
}

.poi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.poi-card {
  cursor: pointer;
}

.map {
  position: relative;
  height: 640rpx;
  background: #eef3f1;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx dashed #ccc;
}

.poi-node {
  position: absolute;
  transform: translate(-50%, -50%);
  text-align: center;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  background: #16a085;
  border: 4rpx solid #fff;
  border-radius: 50%;
  margin: 0 auto;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.dot-name {
  font-size: 22rpx;
  color: #333;
  margin-top: 4rpx;
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}