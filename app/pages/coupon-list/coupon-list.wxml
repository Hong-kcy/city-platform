<view class="container">
  <view class="head">
    <text class="head-title">街区优惠券</text>
    <text class="head-link" bindtap="goMyCoupons">我的优惠券 ›</text>
  </view>

  <view wx:if="{{coupons.length === 0}}" class="empty">暂无可领取的优惠券</view>

  <view
    wx:for="{{coupons}}"
    wx:key="id"
    class="card coupon-card"
    bindtap="openDetail"
    data-id="{{item.id}}"
  >
    <view class="coupon-left">
      <view class="discount">{{item.discountText}}</view>
    </view>
    <view class="coupon-body">
      <view class="card-title">{{item.name}}</view>
      <view class="card-sub">{{item.storeName}}</view>
      <view class="card-sub">{{item.validFrom}} ~ {{item.validTo}}</view>
    </view>
    <view class="coupon-status">{{item.statusText}}</view>
  </view>
</view>
