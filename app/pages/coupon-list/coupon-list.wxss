.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
}

.head-link {
  font-size: 26rpx;
  color: #16a085;
}

.coupon-card {
  display: flex;
  align-items: center;
}

.coupon-left {
  flex-shrink: 0;
  width: 150rpx;
  text-align: center;
  border-right: 2rpx dashed #e5e5e5;
  margin-right: 20rpx;
}

.discount {
  color: #e67e22;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.coupon-body {
  flex: 1;
  min-width: 0;
}

.coupon-status {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #16a085;
  background: #eef7f5;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
