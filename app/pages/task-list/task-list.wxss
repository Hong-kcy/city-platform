.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
}

.head-link {
  font-size: 26rpx;
  color: #16a085;
}

.task-card {
  display: flex;
  align-items: center;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.reward {
  flex-shrink: 0;
  width: 130rpx;
  text-align: center;
  color: #e67e22;
}

.reward-value {
  font-size: 40rpx;
  font-weight: 700;
}

.reward-label {
  font-size: 22rpx;
}
