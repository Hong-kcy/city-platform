/* 全局样式 */
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.card-sub {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.btn-primary {
  background: #16a085;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #eef7f5;
  color: #16a085;
  margin-right: 12rpx;
}

.empty {
  text-align: center;
  color: #aaa;
  padding: 80rpx 0;
  font-size: 26rpx;
}